# BEACON COMPUTING INITIATIVE
# Developer Seal: CJB-DEV-2026
# Component: BCILock Loopback Telemetry API
[Unit]
Description=BCILock private telemetry API
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/local/libexec/bci-telemetry/api.py
User=bci-telemetry
Group=bci-telemetry
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
UMask=0077

[Install]
WantedBy=multi-user.target
